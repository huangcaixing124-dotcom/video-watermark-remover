/* pages/history/history.wxss */
.history-list { display: flex; flex-direction: column; gap: 0; }

.history-item { display: flex; align-items: center; padding: 24rpx 28rpx; }
.history-item-content { flex: 1; display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.history-thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-sm); flex-shrink: 0; object-fit: cover; }
.history-thumb-placeholder { background: var(--bg-input); display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.history-info { flex: 1; min-width: 0; }
.history-title { font-size: 26rpx; font-weight: 500; color: var(--text-primary); display: block; margin-bottom: 6rpx; }
.history-meta { display: flex; align-items: center; gap: 8rpx; margin-bottom: 4rpx; }
.history-date { font-size: 20rpx; color: var(--text-tertiary); }
.history-actions { display: flex; flex-direction: column; gap: 8rpx; margin-left: 12rpx; }
.history-action { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--bg-input); font-size: 24rpx; }
.history-action-delete { color: var(--error); }