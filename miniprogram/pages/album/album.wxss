/* pages/album/album.wxss */
.album-page { min-height: 100vh; background: var(--bg-page); padding: 20rpx; }
.album-page.dark { --bg-page: #0f0f0f; }

.page-header { padding: 20rpx 0 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); display: block; }
.page-subtitle { font-size: 24rpx; color: var(--text-tertiary); margin-top: 8rpx; display: block; }

/* 输入区 */
.input-label { font-size: 26rpx; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 12rpx; }
.input-bar { display: flex; align-items: center; background: var(--bg-input); border: 1.5px solid var(--border-input); border-radius: var(--radius-md); margin-bottom: 20rpx; }
.input-field-url { flex: 1; height: 80rpx; font-size: 26rpx; color: var(--text-primary); background: transparent; border: none; padding: 0 24rpx; outline: none; }
.input-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--text-secondary); }
.action-btn { width: 100%; padding: 28rpx; font-size: 28rpx; border-radius: 20rpx; }

/* 笔记信息 */
.note-header { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.note-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }
.note-avatar-placeholder { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--bg-input); display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0; }
.note-meta { flex: 1; min-width: 0; }
.note-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.note-author { font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; display: block; }
.note-info { font-size: 22rpx; color: var(--text-tertiary); margin-top: 4rpx; display: block; }

/* 文案区域 */
.desc-card { background: var(--bg-input); border-radius: var(--radius-md); padding: 20rpx; margin-bottom: 24rpx; }
.desc-label { font-size: 24rpx; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 8rpx; }
.desc-text { font-size: 26rpx; color: var(--text-primary); line-height: 1.6; display: block; }
.desc-copy-btn { margin-top: 12rpx; padding: 12rpx 24rpx; font-size: 24rpx; border-radius: 12rpx; display: inline-flex; align-items: center; gap: 8rpx; }

/* 图片网格 */
.image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-bottom: 24rpx; }
.grid-image { width: 100%; aspect-ratio: 1; border-radius: 8rpx; object-fit: cover; }

/* 进度条 */
.progress-section { margin-bottom: 24rpx; }
.progress-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.progress-text { font-size: 26rpx; color: var(--text-primary); }
.progress-pct { font-size: 24rpx; color: var(--text-secondary); }
.progress-bar { height: 8rpx; background: var(--bg-input); border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #6366f1, #8b5cf6); border-radius: 4rpx; transition: width 0.3s; }
.progress-hint { font-size: 22rpx; color: var(--text-tertiary); margin-top: 8rpx; display: block; }

/* 操作按钮 */
.save-btn { width: 100%; padding: 28rpx; font-size: 30rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.save-hint { font-size: 22rpx; color: var(--text-tertiary); text-align: center; display: block; }

/* 完成状态 */
.complete-section { text-align: center; padding: 40rpx 0; }
.complete-icon { font-size: 64rpx; margin-bottom: 16rpx; }
.complete-text { font-size: 32rpx; font-weight: 600; color: var(--text-primary); display: block; }
.complete-hint { font-size: 24rpx; color: var(--text-tertiary); margin-top: 8rpx; display: block; }