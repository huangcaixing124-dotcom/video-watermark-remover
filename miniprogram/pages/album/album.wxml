<!-- pages/album/album.wxml -->
<view class="album-page {{isDark ? 'dark' : ''}}">
  <!-- Header -->
  <view class="page-header">
    <text class="page-title">🖼️ 图文下载</text>
    <text class="page-subtitle">小红书/抖音 图片笔记下载</text>
  </view>

  <!-- 输入区域 -->
  <view class="card">
    <view class="input-label">笔记链接</view>
    <view class="input-bar">
      <input class="input-field-url" placeholder="https://xhslink.com/..." value="{{url}}" bindinput="onUrlInput" />
      <view class="input-btn" wx:if="{{url}}" bindtap="clearUrl">✕</view>
    </view>
    <button class="btn btn-primary action-btn" bindtap="pasteAndParse" disabled="{{loading || downloading}}">
      {{loading ? '⏳ 解析中...' : downloading ? '⏳ 保存中...' : '📋 粘贴并解析'}}
    </button>
  </view>

  <!-- 错误 -->
  <view class="error-card" wx:if="{{error}}">
    <text class="error-text">⚠️ {{error}}</text>
    <view class="error-actions">
      <button class="btn btn-secondary" style="flex:1" bindtap="newDownload">清空链接</button>
    </view>
  </view>

  <!-- 解析/保存进度（独立于笔记信息卡片，解析阶段 noteInfo 为空也能显示） -->
  <view class="card" wx:if="{{(loading || downloading) && !error}}">
    <view class="progress-section">
      <view class="progress-row">
        <text class="progress-text">{{statusText}}</text>
        <text class="progress-pct">{{progress}}%</text>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width:{{progress}}%"></view></view>
      <text class="progress-hint">{{statusHint}}</text>
    </view>
  </view>

  <!-- 笔记信息 -->
  <view class="card" wx:if="{{noteInfo && !error}}">
    <!-- 笔记头部 -->
    <view class="note-header">
      <view class="note-avatar-placeholder">🖼️</view>
      <view class="note-meta">
        <text class="note-title">{{noteInfo.title || '笔记'}}</text>
        <text class="note-author" wx:if="{{noteInfo.author}}">{{noteInfo.author}}</text>
        <text class="note-info">{{noteInfo.platform}} · {{imageCount}}张图片</text>
      </view>
    </view>

    <!-- 文案 -->
    <view class="desc-card" wx:if="{{description}}">
      <text class="desc-label">文案</text>
      <text class="desc-text">{{description}}</text>
      <button class="btn btn-secondary desc-copy-btn" bindtap="copyDescription">📋 复制文案</button>
    </view>

    <!-- 图片网格（可多选） -->
    <view class="image-grid" wx:if="{{images.length > 0}}">
      <view
        class="grid-item"
        wx:for="{{images}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="toggleSelect"
      >
        <image class="grid-image {{item.selected ? '' : 'grid-image-unselected'}}" src="{{item.proxy}}" mode="aspectFill" data-index="{{index}}" />
        <view class="grid-checkbox {{item.selected ? 'grid-checkbox-on' : ''}}">
          <text wx:if="{{item.selected}}">✓</text>
          <text wx:else class="grid-index">{{index + 1}}</text>
        </view>
      </view>
    </view>

    <!-- 全选/取消全选 -->
    <view class="select-tools" wx:if="{{images.length > 0}}">
      <view class="select-all-btn" bindtap="toggleSelectAll">
        {{selectedCount === images.length ? '取消全选' : '全选'}}（{{selectedCount}}/{{images.length}}）
      </view>
      <text class="select-hint">点击图片可选择/取消</text>
    </view>

    <!-- 进度 -->
    <view class="progress-section" wx:if="{{downloading}}">
      <view class="progress-row">
        <text class="progress-text">{{statusText}}</text>
        <text class="progress-pct">{{progress}}%</text>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width:{{progress}}%"></view></view>
      <text class="progress-hint" wx:if="{{statusHint}}">{{statusHint}}</text>
    </view>

    <!-- 下载选中按钮 -->
    <button class="btn btn-primary save-btn" wx:elif="{{!downloading && images.length > 0}}" bindtap="saveSelectedImages" disabled="{{saving || selectedCount <= 0}}">
      {{saving ? '⏳ 保存中...' : selectedCount > 0 ? '▤ 下载选中 (' + selectedCount + '张)' : '请选择图片'}}
    </button>
    <text class="save-hint" wx:if="{{!downloading && images.length > 0}}">共{{selectedCount}}张已选中，保存到手机相册</text>
  </view>

  <!-- 图片预览遮罩 -->
  <view class="preview-overlay" wx:if="{{previewVisible}}" bindtap="closePreview">
    <view class="preview-content" catchtap>
      <view class="preview-header">
        <text class="preview-title">{{previewTitle}}</text>
        <view class="preview-close" bindtap="closePreview">✕</view>
      </view>
      <image class="preview-image" src="{{previewUrl}}" mode="aspectFit" />
      <view class="preview-nav">
        <view class="preview-nav-btn" catchtap="prevImage">◀ 上一张</view>
        <view class="preview-download-btn" catchtap="downloadCurrentPreview">💾 下载</view>
        <view class="preview-nav-btn" catchtap="nextImage">下一张 ▶</view>
      </view>
    </view>
  </view>

  <!-- 引导到下载页 -->
  <view class="guide-card" bindtap="goDownload">
    <text class="guide-text">🎬 需要下载视频？去下载页</text>
    <text class="guide-arrow">→</text>
  </view>

  <view class="safe-bottom"></view>
</view>