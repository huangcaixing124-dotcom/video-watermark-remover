/* pages/index/index.wxss */
.container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-top: 12rpx;
}

/* 功能卡片 */
.feature-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.feature-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.08);
}

.feature-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.feature-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

/* 支持平台卡片 */
.platforms-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(99, 102, 241, 0.06);
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 20rpx;
}

.platform-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.platform-tag {
  background: #ede9fe;
  color: #6366f1;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 设置链接 */
.settings-link {
  text-align: center;
  padding: 20rpx;
  color: #64748b;
  font-size: 26rpx;
}

.settings-link:active {
  color: #6366f1;
}