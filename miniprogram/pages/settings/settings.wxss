/* pages/settings/settings.wxss */
.setting-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1px solid var(--border); }
.setting-item-left { flex: 1; }
.setting-item-label { font-size: 28rpx; font-weight: 500; color: var(--text-primary); display: block; }
.setting-item-desc { font-size: 22rpx; color: var(--text-tertiary); display: block; margin-top: 4rpx; }
.setting-item-arrow { font-size: 28rpx; color: var(--text-tertiary); }
.setting-input { width: 100%; background: var(--bg-input); border: 1px solid var(--border-input); border-radius: var(--radius-sm); padding: 20rpx 24rpx; font-size: 26rpx; color: var(--text-primary); margin: 16rpx 0; }

.status-badge { font-size: 22rpx; font-weight: 500; padding: 6rpx 16rpx; border-radius: 8rpx; flex-shrink: 0; }
.status-badge.connected { background: #dcfce7; color: #16a34a; }
.status-badge.disconnected { background: #fef2f2; color: #dc2626; }

.theme-options { display: flex; gap: 16rpx; }
.theme-option { flex: 1; text-align: center; padding: 20rpx; border-radius: var(--radius-md); background: var(--bg-input); border: 2px solid transparent; }
.theme-option.active { border-color: var(--primary); background: var(--primary-light); }
.theme-option-icon { font-size: 36rpx; display: block; margin-bottom: 8rpx; }
.theme-option-label { font-size: 24rpx; color: var(--text-primary); font-weight: 500; }

.about-text { font-size: 26rpx; color: var(--text-secondary); display: block; margin-bottom: 6rpx; }
.about-license { font-size: 22rpx; color: var(--text-tertiary); display: block; margin-top: 20rpx; }