/* pages/settings/settings.wxss */
.container {
  padding: 40rpx;
  background: #f8fafc;
}

.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

/* 设置卡片 */
.setting-card {
  margin-bottom: 24rpx;
}

.setting-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  display: block;
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #1e293b;
  margin-bottom: 20rpx;
}

.btn-primary {
  width: 100%;
}

.hint {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  display: block;
  margin-top: 16rpx;
}

/* 状态卡片 */
.status-card {
  margin-bottom: 24rpx;
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 关于卡片 */
.about-card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 16rpx;
}

.about-text {
  font-size: 26rpx;
  color: #475569;
  display: block;
  margin-bottom: 8rpx;
}