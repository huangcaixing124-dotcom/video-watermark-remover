<!-- pages/transcript/transcript.wxml -->
<view class="container">
  <!-- 标题 -->
  <view class="page-header">
    <text class="page-title">视频文案提取</text>
    <text class="page-subtitle">视频语音转文字，支持导出SRT字幕</text>
  </view>

  <!-- URL 输入区 -->
  <view class="input-card card" wx:if="{{!taskId}}">
    <text class="input-label">视频链接</text>
    <textarea
      class="input-field"
      placeholder="粘贴视频链接，如 https://v.douyin.com/xxxxx"
      value="{{url}}"
      bindinput="onUrlInput"
      auto-focus
    />
    <button class="btn-primary" bindtap="startTranscript" disabled="{{loading}}">
      {{loading ? '处理中...' : '提取文案'}}
    </button>
    <text class="hint">需要下载视频并提取音频，可能需要几分钟</text>
  </view>

  <!-- 处理进度 -->
  <view class="progress-card card" wx:else>
    <view class="progress-header">
      <text class="status-text">{{statusText}}</text>
      <text class="progress-text">{{progress}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-bar-fill" style="width: {{progress}}%" />
    </view>
    <text class="progress-hint">{{progressHint}}</text>
  </view>

  <!-- 文案展示 -->
  <view class="result-card card" wx:if="{{text}}">
    <view class="result-header">
      <text class="card-title">提取结果</text>
      <view class="action-buttons">
        <button class="btn-secondary" size="mini" bindtap="copyText">📋 复制</button>
        <button class="btn-secondary" size="mini" bindtap="exportSrt">💾 导出SRT</button>
      </view>
    </view>
    <scroll-view scroll-y class="text-scroll">
      <text class="transcript-text">{{text}}</text>
    </scroll-view>
  </view>

  <!-- 错误提示 -->
  <view class="error-card" wx:if="{{error}}">
    <text class="error-text">⚠️ {{error}}</text>
    <button class="btn-secondary" bindtap="resetTask">重新开始</button>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!taskId && !text && !error}}">
    <view class="empty-icon">🎙️</view>
    <text class="empty-state-text">输入视频链接，开始提取文案</text>
  </view>
</view>