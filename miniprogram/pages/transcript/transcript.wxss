/* pages/transcript/transcript.wxss */
.input-label { font-size: 26rpx; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 12rpx; }
.input-bar { display: flex; align-items: center; background: var(--bg-input); border: 1.5px solid var(--border-input); border-radius: var(--radius-md); margin-bottom: 20rpx; }
.input-bar:focus-within { border-color: var(--primary); }
.input-field-url { flex: 1; height: 80rpx; font-size: 26rpx; color: var(--text-primary); background: transparent; border: none; padding: 0 24rpx; outline: none; }
.input-bar-actions { display: flex; gap: 4rpx; padding-right: 8rpx; }
.input-btn { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--text-secondary); border-radius: 50%; }

.detect-card { background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: var(--radius-lg); padding: 24rpx 28rpx; margin-bottom: 20rpx; }
.detect-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.detect-icon { font-size: 32rpx; }
.detect-info { flex: 1; min-width: 0; }
.detect-label { font-size: 26rpx; font-weight: 600; color: white; display: block; }
.detect-url { font-size: 20rpx; color: rgba(255,255,255,0.7); display: block; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detect-actions { display: flex; gap: 12rpx; }

.progress-section { padding: 8rpx 0; }
.progress-row { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.progress-text { font-size: 26rpx; color: var(--primary); }
.progress-pct { font-size: 26rpx; font-weight: 600; color: var(--primary); }
.progress-hint { font-size: 22rpx; color: var(--text-tertiary); text-align: center; display: block; margin-top: 12rpx; }

.result-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.result-actions { display: flex; gap: 6rpx; }
.text-preview { max-height: 600rpx; background: var(--bg-input); border-radius: var(--radius-md); padding: 24rpx; }
.text-content { font-size: 26rpx; line-height: 1.8; color: var(--text-primary); white-space: pre-wrap; word-break: break-word; }

.error-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }

.guide-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 28rpx 32rpx; display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.guide-text { font-size: 26rpx; color: var(--primary); font-weight: 500; }
.guide-arrow { font-size: 28rpx; color: var(--primary); }