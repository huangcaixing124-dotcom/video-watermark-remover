/* pages/download/download.wxss */
.container {
  padding: 40rpx;
  background: #f8fafc;
}

.page-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  margin-top: 8rpx;
}

/* 输入卡片 */
.input-card {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  display: block;
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  min-height: 200rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #1e293b;
  margin-bottom: 20rpx;
}

.btn-primary {
  width: 100%;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

/* 视频预览卡片 */
.preview-card {
  margin-bottom: 24rpx;
}

.preview-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.thumbnail {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.video-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.video-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #ede9fe;
  color: #6366f1;
}

.author {
  font-size: 24rpx;
  color: #64748b;
}

.duration {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 下载区域 */
.download-section {
  margin-top: 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  display: block;
  margin-top: 16rpx;
}

/* 进度区域 */
.progress-section {
  margin-top: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: #6366f1;
}

.progress-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #6366f1;
}

.progress-bar {
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 错误卡片 */
.error-card {
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.error-text {
  font-size: 26rpx;
  color: #ef4444;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}