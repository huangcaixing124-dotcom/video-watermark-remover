<!-- pages/download/download.wxml -->
<view class="page {{isDark ? 'dark' : ''}}">
  <!-- Header -->
  <view class="page-header">
    <text class="page-title">视频下载</text>
    <text class="page-subtitle">抖音/快手/B站/小红书/豆包 高清下载</text>
  </view>

  <!-- 输入区域 -->
  <view class="card">
    <view class="input-label">视频链接</view>
    <view class="input-bar">
      <input class="input-field-url" placeholder="https://v.douyin.com/..." value="{{url}}" bindinput="onUrlInput" />
      <view class="input-btn" wx:if="{{url}}" bindtap="clearUrl">✕</view>
    </view>
    <view class="action-row">
      <button class="btn btn-primary action-btn" bindtap="pasteAndDownload" disabled="{{loading || downloading || saving || (_phoneCachePath) || (taskId && progress >= 100)}}">
        {{loading ? '⏳ 解析中...' : downloading ? '⏳ 下载中...' : '📋 粘贴并解析'}}
      </button>
      <button class="btn btn-secondary action-btn-secondary" wx:if="{{url || videoInfo || taskId || error}}" bindtap="newDownload">清空链接</button>
    </view>
  </view>

  <!-- 视频信息 -->
  <view class="card" wx:if="{{videoInfo && !error}}">
    <view class="preview-row" bindtap="showPreview" style="cursor:pointer">
      <image class="preview-thumb" src="{{videoInfo.thumbnailUrl || ''}}" mode="aspectFill" wx:if="{{videoInfo.thumbnailUrl}}" />
      <view class="preview-thumb preview-thumb-fallback" wx:else>🎬</view>
      <view class="preview-meta">
        <text class="preview-title">{{videoInfo.title || '视频'}}</text>
        <view class="preview-tags">
          <text class="tag">{{videoInfo.platform || '未知'}}</text>
          <text wx:if="{{videoInfo.author}}" style="color:var(--text-secondary);font-size:24rpx">@{{videoInfo.author}}</text>
          <text wx:if="{{videoInfo.durationFormatted}}" style="color:var(--text-tertiary);font-size:24rpx">{{videoInfo.durationFormatted}}</text>
        </view>
        <text style="color:var(--primary);font-size:22rpx;margin-top:12rpx;display:block">▶ 点击预览视频</text>
      </view>
    </view>

    <!-- 下载进度 -->
    <view class="progress-section" wx:if="{{downloading && progress < 100}}">
      <view class="progress-row">
        <text class="progress-text">{{statusText}}</text>
        <text class="progress-pct">{{progress}}%</text>
      </view>
      <view class="progress-bar"><view class="progress-fill" style="width:{{progress}}%"></view></view>
      <text class="progress-hint">{{statusHint}}</text>
    </view>

    <!-- 下载完成 -->
    <view class="complete-section" wx:elif="{{progress >= 100 && (taskId || _phoneCachePath)}}">
      <view class="complete-icon">✅</view>
      <text class="complete-text">下载完成！</text>
      <text class="complete-hint">点击下方按钮保存到手机相册</text>
      <button class="btn btn-primary dl-btn" bindtap="saveToAlbum" disabled="{{saving}}">{{saving ? '⏳ 保存中...' : '💾 保存到相册'}}</button>
    </view>
  </view>

  <!-- 错误 -->
  <view class="error-card" wx:if="{{error}}">
    <text class="error-text">⚠️ {{error}}</text>
    <view class="error-actions">
      <button class="btn btn-secondary" style="flex:1" bindtap="retry">🔄 重试</button>
      <button class="btn btn-secondary" style="flex:1" bindtap="newDownload">清空链接</button>
    </view>
  </view>

  <!-- 引导到文案页 -->
  <view class="guide-card" bindtap="goTranscript">
    <text class="guide-text">📝 需要提取视频文案（语音转文字）？去文案页</text>
    <text class="guide-arrow">→</text>
  </view>

  <!-- 视频预览遮罩层 -->
  <view class="preview-overlay" wx:if="{{showPreview}}" bindtap="hidePreview">
    <view class="preview-overlay-content" catchtap>
      <view class="preview-overlay-header">
        <text class="preview-overlay-title">{{previewTitle}}</text>
        <view class="preview-close-btn" bindtap="hidePreview">✕</view>
      </view>
      <video
        class="preview-video"
        src="{{previewUrl}}"
        controls
        autoplay
        show-center-play-btn="{{true}}"
        enable-progress-gesture="{{true}}"
        object-fit="contain"
      />
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>