/* app.wxss - 清爽明亮主题 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: #f8fafc;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 全局样式 */
.container {
  padding: 40rpx;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(99, 102, 241, 0.06);
  margin-bottom: 24rpx;
}

/* 品牌色按钮 */
.btn-primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  text-align: center;
  padding: 24rpx;
}

.btn-primary:active {
  opacity: 0.9;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
  padding: 24rpx;
}

.btn-secondary:active {
  background: #e2e8f0;
}

/* 输入框 */
.input-field {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.input-field:focus {
  border-color: #6366f1;
  background: #ffffff;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #ede9fe;
  color: #6366f1;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

/* 加载状态 */
.loading-text {
  color: #94a3b8;
  font-size: 28rpx;
  text-align: center;
  padding: 40rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-state-text {
  color: #94a3b8;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 错误提示 */
.error-text {
  color: #ef4444;
  font-size: 26rpx;
}

/* 成功提示 */
.success-text {
  color: #22c55e;
  font-size: 26rpx;
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}