/* ── Design System: 去水印视频工具 ────────────────────────────── */

/* Light Theme (default) */
page {
  --bg: #faf9f6;
  --bg-card: rgba(255, 255, 255, 0.78);
  --bg-card-solid: #ffffff;
  --bg-input: #f5f5f0;
  --bg-hover: #f0efeb;
  --text-primary: #1c1c1e;
  --text-secondary: #6b7280;
  --text-tertiary: #9ca3af;
  --text-inverse: #ffffff;
  --border: rgba(0, 0, 0, 0.06);
  --border-input: rgba(0, 0, 0, 0.1);
  --shadow: 0 4rpx 24rpx rgba(99, 102, 241, 0.06);
  --shadow-lg: 0 8rpx 40rpx rgba(99, 102, 241, 0.1);
  --primary: #6366f1;
  --primary-light: #ede9fe;
  --primary-gradient: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  --accent: #f59e0b;
  --success: #10b981;
  --error: #ef4444;
  --error-bg: #fef2f2;
  --error-border: #fecaca;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}

/* Dark Theme */
page.dark {
  --bg: #0a0a0f;
  --bg-card: rgba(255, 255, 255, 0.06);
  --bg-card-solid: #1a1a24;
  --bg-input: #1c1c26;
  --bg-hover: #252532;
  --text-primary: #f5f5f7;
  --text-secondary: #9ca3af;
  --text-tertiary: #6b7280;
  --text-inverse: #0a0a0f;
  --border: rgba(255, 255, 255, 0.08);
  --border-input: rgba(255, 255, 255, 0.12);
  --shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 8rpx 40rpx rgba(0, 0, 0, 0.4);
  --primary-light: rgba(99, 102, 241, 0.2);
  --error-bg: rgba(239, 68, 68, 0.15);
  --error-border: rgba(239, 68, 68, 0.3);
}

/* ── Base ── */
page {
  font-family: var(--font);
  background-color: var(--bg);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  transition: background-color 0.3s, color 0.3s;
}

/* ── Layout ── */
.page {
  padding: 0 32rpx 32rpx;
  min-height: 100vh;
  padding-bottom: calc(32rpx + var(--safe-bottom));
}

.page-header {
  padding: 40rpx 0 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--text-primary);
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-top: 8rpx;
}

/* ── Cards ── */
.card {
  background: var(--bg-card);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
  border: 1px solid var(--border);
  transition: background 0.3s, box-shadow 0.3s;
}

.card-solid {
  background: var(--bg-card-solid);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
  border: 1px solid var(--border);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 20rpx;
}

/* ── Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  padding: 24rpx 40rpx;
  border: none;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.btn:active {
  transform: scale(0.97);
}

.btn-primary {
  background: var(--primary-gradient);
  color: white;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-secondary {
  background: var(--bg-input);
  color: var(--text-primary);
  width: 100%;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  padding: 16rpx 24rpx;
}

.btn-small {
  font-size: 24rpx;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-sm);
}

.btn-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  padding: 0;
  background: var(--bg-card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

/* ── Inputs ── */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg-input);
  border: 1.5px solid var(--border-input);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: border-color 0.2s, background 0.2s;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--primary);
  background: var(--bg-card);
}

.input-field.plain {
  min-height: auto;
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
}

/* ── Tags / Badges ── */
.tag {
  display: inline-block;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-sm {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--primary);
  color: white;
  font-size: 20rpx;
  font-weight: 600;
}

/* ── Progress ── */
.progress-bar {
  height: 6rpx;
  background: var(--border-input);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--primary-gradient);
  border-radius: 3rpx;
  transition: width 0.4s ease;
}

/* ── Status ── */
.status-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.online { background: var(--success); }
.status-dot.offline { background: var(--error); }

/* ── Text utilities ── */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-error { color: var(--error); }
.text-success { color: var(--success); }
.text-center { text-align: center; }
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Empty state ── */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ── Error card ── */
.error-card {
  background: var(--error-bg);
  border: 1px solid var(--error-border);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-top: 20rpx;
}

.error-text {
  font-size: 26rpx;
  color: var(--error);
}

/* ── Loading shimmer ── */
.shimmer {
  background: linear-gradient(90deg, var(--bg-input) 25%, var(--bg-hover) 50%, var(--bg-input) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Section divider ── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* ── Safe area ── */
.safe-bottom {
  height: calc(32rpx + var(--safe-bottom));
}

/* ── Ripple ── */
.ripple {
  position: relative;
  overflow: hidden;
}

.ripple::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 10%, transparent 10%);
  background-position: 50%;
  background-size: 0%;
  opacity: 0;
  transition: none;
}

.ripple:active::after {
  background-size: 1000%;
  opacity: 1;
  transition: background-size 0.6s, opacity 0.3s;
}

/* ── Toast override ── */
.wx-toast {
  border-radius: var(--radius-md) !important;
}