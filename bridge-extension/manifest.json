{
  "manifest_version": 3,
  "name": "Douyin Video Bridge",
  "version": "1.1",
  "permissions": [
    "webRequest",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.doubao.com/*",
    "http://localhost/*"
  ],
  "content_scripts": [{
    "matches": ["https://*.douyin.com/*", "https://*.doubao.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "background": {
    "service_worker": "background.js"
  }
}
