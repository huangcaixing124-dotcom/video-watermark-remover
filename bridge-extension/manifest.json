{
  "manifest_version": 3,
  "name": "Video Download Bridge",
  "version": "1.5",
  "permissions": [
    "webRequest",
    "downloads",
    "tabs",
    "alarms",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.doubao.com/*",
    "https://*.kuaishou.com/*",
    "https://*.kwimgs.com/*",
    "https://*.yximgs.com/*",
    "http://localhost/*"
  ],
  "content_scripts": [{
    "matches": ["https://*.kuaishou.com/*", "https://*.doubao.com/*", "https://*.douyin.com/*"],
    "js": ["content.js"],
    "run_at": "document_end",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["main.js"],
    "matches": ["https://*.kuaishou.com/*", "https://*.doubao.com/*", "https://*.douyin.com/*"]
  }],
  "background": {
    "service_worker": "background.js"
  }
}